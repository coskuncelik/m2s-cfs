 static bool xTimerTickThreadShouldRun;
 static uint64_t prvStartTimeNs;
+static uint64_t prvTicksProcessed; /* m2s-cfs: ticks already passed to xTaskIncrementTick() */
 static pthread_key_t xThreadKey = 0;
 /*-----------------------------------------------------------*/
 
@@ -451,6 +452,9 @@
 
 static void * prvTimerTickHandler( void * arg )
 {
+    uint64_t xNextNs = prvStartTimeNs;
+    struct timespec xDeadline;
+
     ( void ) arg;
 
     prvMarkAsFreeRTOSThread();
@@ -465,7 +469,16 @@
          */
         Thread_t * thread = prvGetThreadFromTask( xTaskGetCurrentTaskHandle() );
         pthread_kill( thread->pthread, SIGALRM );
-        usleep( portTICK_RATE_MICROSECONDS );
+
+        /* m2s-cfs: sleep to an absolute deadline instead of a relative usleep(),
+         * so host sleep overshoot does not accumulate. */
+        xNextNs += ( uint64_t ) portTICK_RATE_MICROSECONDS * 1000ULL;
+        xDeadline.tv_sec = ( time_t ) ( xNextNs / 1000000000ULL );
+        xDeadline.tv_nsec = ( long ) ( xNextNs % 1000000000ULL );
+
+        while( clock_nanosleep( CLOCK_MONOTONIC, TIMER_ABSTIME, &xDeadline, NULL ) == EINTR )
+        {
+        }
     }
 
     return NULL;
@@ -478,10 +491,12 @@
  */
